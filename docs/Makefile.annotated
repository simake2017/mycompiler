# =============================================================================
# CMake 生成的 Makefile（带详细中文注释）
# =============================================================================
# 原始文件: build/Makefile
# 由 CMake 的 "Unix Makefiles" 生成器自动生成
#
# 这个文件是 cmake 根据 CMakeLists.txt "翻译"出来的。
# make 只读这个文件，不读 CMakeLists.txt。
# 但 cmake 在里面埋了"哨兵"机制，自动检测 CMakeLists.txt 是否被修改。
#
# =============================================================================

# ─── 文件头：声明这是自动生成的 ───────────────────────────────────────────────
# CMAKE generated file: DO NOT EDIT!
# Generated by "Unix Makefiles" Generator, CMake Version 3.20

# ─── 默认目标 ─────────────────────────────────────────────────────────────────
# 当你在终端直接敲 "make"（不加目标名）时，make 执行第一个定义的目标
# 这里第一个目标是 default_target，它依赖 all
default_target: all
.PHONY : default_target

# ─── 防止 make 自身的并行（但允许子 make 并行）───────────────────────────────
# 因为多个 make 同时写同一个文件会冲突
.NOTPARALLEL:

# =============================================================================
# CMake 的特殊设置
# =============================================================================

# ─── 禁用 make 的隐式规则 ─────────────────────────────────────────────────────
# make 自带一些"默认规则"（比如 .c → .o 的默认编译方式）
# CMake 不需要这些，全部禁用，避免干扰
.SUFFIXES:

# ─── 禁用版本控制系统的隐式规则 ──────────────────────────────────────────────
# make 默认会从 RCS、SCCS 等古老版本控制系统中获取文件
# 这些完全用不到，禁用以避免意外行为
% : %,v
% : RCS/%
% : RCS/%,v
% : SCCS/s.%
% : s.%

.SUFFIXES: .hpux_make_needs_suffix_list

# ─── 静默模式控制 ─────────────────────────────────────────────────────────────
# make VERBOSE=1 时会打印完整命令
# 默认不打印（静默模式），只显示进度信息
$(VERBOSE)MAKESILENT = -s
$(VERBOSE).SILENT:

# ─── 一个永远"过期"的目标 ─────────────────────────────────────────────────────
# 任何依赖它的目标都会被重新执行
cmake_force:
.PHONY : cmake_force

# =============================================================================
# 环境变量设置
# =============================================================================

# ─── Shell ────────────────────────────────────────────────────────────────────
SHELL = /bin/sh

# ─── cmake 可执行文件的路径 ───────────────────────────────────────────────────
CMAKE_COMMAND = /Applications/CMake.app/Contents/bin/cmake

# ─── 删除文件的命令（跨平台）──────────────────────────────────────────────────
RM = /Applications/CMake.app/Contents/bin/cmake -E rm -f

# ─── 特殊字符转义 ─────────────────────────────────────────────────────────────
EQUALS = =

# ─── 源码目录和构建目录 ───────────────────────────────────────────────────────
# ★ 这就是 cmake .. 中 ".." 的含义 ── cmake 从上一级目录读取 CMakeLists.txt
CMAKE_SOURCE_DIR = /Users/wangyang/cppproject/mycompiler      ← CMakeLists.txt 在这里
CMAKE_BINARY_DIR = /Users/wangyang/cppproject/mycompiler/build ← Makefile 在这里

# =============================================================================
# CMake 提供的全局目标
# =============================================================================

# ─── rebuild_cache: 手动强制重新运行 cmake 配置 ──────────────────────────────
# 用法: make rebuild_cache
# 效果: 等同于重新执行 cmake ..
rebuild_cache:
    @$(CMAKE_COMMAND) -E cmake_echo_color --switch=$(COLOR) --cyan \
        "Running CMake to regenerate build system..."
    /Applications/CMake.app/Contents/bin/cmake \
        --regenerate-during-build -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR)
.PHONY : rebuild_cache

rebuild_cache/fast: rebuild_cache
.PHONY : rebuild_cache/fast

# ─── edit_cache: 打开 CMake 的交互式配置编辑器 (ccmake) ──────────────────────
# 用法: make edit_cache
# 效果: 打开一个终端 UI，可以修改 CMake 变量
edit_cache:
    @$(CMAKE_COMMAND) -E cmake_echo_color --switch=$(COLOR) --cyan \
        "Running CMake cache editor..."
    /Applications/CMake.app/Contents/bin/ccmake \
        -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR)
.PHONY : edit_cache

edit_cache/fast: edit_cache
.PHONY : edit_cache/fast

# =============================================================================
# ★★★ 核心目标：all ★★★
# =============================================================================
#
# 这是 make 的默认目标（你在终端敲 make 就会执行这个）
#
# 执行顺序:
#   1. cmake_check_build_system  ← 检查 CMakeLists.txt 是否被修改
#   2. cmake_progress_start      ← 初始化进度条（显示 [ 12%] 这种）
#   3. make -f Makefile2 all     ← 递归调用 Makefile2 执行真正的编译
#   4. cmake_progress_start 0    ← 清理进度条
#
all: cmake_check_build_system                                       ← ★ 第一步：检查
    $(CMAKE_COMMAND) -E cmake_progress_start \
        .../build/CMakeFiles .../build/CMakeFiles/progress.marks    ← 初始化进度
    $(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 all              ← ★ 第二步：编译
    $(CMAKE_COMMAND) -E cmake_progress_start \
        .../build/CMakeFiles 0                                      ← 清理进度
.PHONY : all

# =============================================================================
# clean 目标：清理编译产物
# =============================================================================
# 用法: make clean
# 效果: 删除所有 .o 文件和 minicc 可执行文件
clean:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 clean
.PHONY : clean

clean/fast: clean
.PHONY : clean/fast

# =============================================================================
# preinstall 目标：为 make install 做准备
# =============================================================================
preinstall: all
    $(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 preinstall
.PHONY : preinstall

preinstall/fast:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 preinstall
.PHONY : preinstall/fast

# =============================================================================
# depend 目标：重新扫描头文件依赖
# =============================================================================
depend:
    $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) \
        --check-build-system CMakeFiles/Makefile.cmake 1
.PHONY : depend

# =============================================================================
# minicc 目标：构建编译器
# =============================================================================
# 用法: make minicc
#
# 注意: minicc 也依赖 cmake_check_build_system
#       所以即使你只 make minicc，也会先检查 CMakeLists.txt
minicc: cmake_check_build_system                                    ← 先检查
    $(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 minicc            ← 再编译
.PHONY : minicc

# minicc/fast: 跳过 cmake_check_build_system，直接编译
# 用法: make minicc/fast（不检查 CMakeLists.txt，更快但不安全）
minicc/fast:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/build
.PHONY : minicc/fast

# =============================================================================
# 每个源文件的编译目标
# =============================================================================
#
# 每个 .cpp 文件有 3 个子目标：
#   src/xxx.o  → 编译成 .o 文件
#   src/xxx.i  → 预处理（展开所有 #include 后的结果）
#   src/xxx.s  → 生成汇编代码（不编译）
#
# 这些目标的实际编译命令在 CMakeFiles/minicc.dir/build.make 中
# 这里只是转发调用

# ─── codegen.cpp ──────────────────────────────────────────────────────────────
src/codegen.o: src/codegen.cpp.o                                   ← .o 目标
.PHONY : src/codegen.o

src/codegen.cpp.o:                                                  ← 实际编译
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/codegen.cpp.o
.PHONY : src/codegen.cpp.o

src/codegen.i: src/codegen.cpp.i                                   ← 预处理目标
.PHONY : src/codegen.i
src/codegen.cpp.i:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/codegen.cpp.i
.PHONY : src/codegen.cpp.i

src/codegen.s: src/codegen.cpp.s                                   ← 汇编目标
.PHONY : src/codegen.s
src/codegen.cpp.s:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/codegen.cpp.s
.PHONY : src/codegen.cpp.s

# ─── lexer.cpp ────────────────────────────────────────────────────────────────
src/lexer.o: src/lexer.cpp.o
.PHONY : src/lexer.o
src/lexer.cpp.o:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/lexer.cpp.o
.PHONY : src/lexer.cpp.o

src/lexer.i: src/lexer.cpp.i
.PHONY : src/lexer.i
src/lexer.cpp.i:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/lexer.cpp.i
.PHONY : src/lexer.cpp.i

src/lexer.s: src/lexer.cpp.s
.PHONY : src/lexer.s
src/lexer.cpp.s:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/lexer.cpp.s
.PHONY : src/lexer.cpp.s

# ─── main.cpp ─────────────────────────────────────────────────────────────────
src/main.o: src/main.cpp.o
.PHONY : src/main.o
src/main.cpp.o:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/main.cpp.o
.PHONY : src/main.cpp.o

src/main.i: src/main.cpp.i
.PHONY : src/main.i
src/main.cpp.i:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/main.cpp.i
.PHONY : src/main.cpp.i

src/main.s: src/main.cpp.s
.PHONY : src/main.s
src/main.cpp.s:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/main.cpp.s
.PHONY : src/main.cpp.s

# ─── parser.cpp ───────────────────────────────────────────────────────────────
src/parser.o: src/parser.cpp.o
.PHONY : src/parser.o
src/parser.cpp.o:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/parser.cpp.o
.PHONY : src/parser.cpp.o

src/parser.i: src/parser.cpp.i
.PHONY : src/parser.i
src/parser.cpp.i:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
        CMakeFiles/minicc.dir/src/parser.cpp.i
.PHONY : src/parser.cpp.i

src/parser.s: src/parser.cpp.s
.PHONY : src/parser.s
src/parser.cpp.s:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
