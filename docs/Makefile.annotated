# =============================================================================
# help 目标：打印所有可用的 make 目标
# =============================================================================
# 用法: make help
help:
    @echo "The following are some of the valid targets for this Makefile:"
    @echo "... all (the default if no target is provided)"
    @echo "... clean"
    @echo "... depend"
    @echo "... edit_cache"
    @echo "... rebuild_cache"
    @echo "... minicc"
    @echo "... src/codegen.o"
    @echo "... src/lexer.o"
    @echo "... src/main.o"
    @echo "... src/parser.o"
    @echo "... src/semantic_analyzer.o"
    @echo "... src/template_instantiation.o"
    @echo "... src/type.o"
    @echo "... (以及每个文件的 .i 预处理和 .s 汇编目标)"
.PHONY : help

# =============================================================================
# ★★★ cmake_check_build_system —— 最关键的"哨兵" ★★★
# =============================================================================
#
# 这是 CMake 自动检测 CMakeLists.txt 变更的核心机制！
#
# 每次执行 make 时，all 和 minicc 目标都依赖这个目标。
# 它运行 cmake --check-build-system，该命令会：
#
#   1. 读取 CMakeFiles/Makefile.cmake 中记录的所有依赖文件
#      (包括 ../CMakeLists.txt)
#
#   2. 比较这些文件的修改时间与当前 Makefile 的修改时间
#
#   3. 如果任何依赖文件比 Makefile 更新：
#      → 自动重新运行 cmake 配置
#      → 重新生成 Makefile、flags.make、link.txt 等
#      → 然后才继续编译
#
#   4. 如果都没改过：
#      → 什么都不做，直接继续编译
#
# 这就是为什么你改了 CMakeLists.txt 后不需要手动 cmake ..
#
cmake_check_build_system:
    $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) \
        --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system


# =============================================================================
# 附：flags.make —— 编译选项（从 CMakeLists.txt 翻译来）
# =============================================================================
#
# 文件位置: build/CMakeFiles/minicc.dir/flags.make
#
# 内容:
#   CXX_DEFINES =                        ← add_definitions() 或 -D 选项
#   CXX_INCLUDES = -I.../include         ← target_include_directories()
#   CXX_FLAGS = -g -arch arm64           ← CMAKE_CXX_FLAGS + target_compile_options()
#               -Wall -Wextra -pedantic
#               -std=gnu++20             ← CMAKE_CXX_STANDARD 20
#
# 对应关系:
#   CMakeLists.txt                          flags.make
#   ───────────────────────────────         ─────────────────────
#   target_include_directories(... include) → CXX_INCLUDES = -I.../include
#   target_compile_options(... -Wall ...)   → CXX_FLAGS 中包含 -Wall -Wextra
#   set(CMAKE_CXX_STANDARD 20)             → CXX_FLAGS 中包含 -std=gnu++20
#
# =============================================================================

# =============================================================================
# 附：link.txt —— 链接命令（从 CMakeLists.txt 翻译来）
# =============================================================================
#
# 文件位置: build/CMakeFiles/minicc.dir/link.txt
#
# 完整的一行链接命令:
#
#   /opt/homebrew/opt/llvm/bin/clang++
#       -g -arch arm64
#       -L/opt/homebrew/opt/llvm/lib            ← Homebrew LLVM 默认加的
#       CMakeFiles/minicc.dir/src/lexer.cpp.o    ← 所有 .o 文件
#       CMakeFiles/minicc.dir/src/parser.cpp.o
#       CMakeFiles/minicc.dir/src/type.cpp.o
#       CMakeFiles/minicc.dir/src/semantic_analyzer.cpp.o
#       CMakeFiles/minicc.dir/src/template_instantiation.cpp.o
#       CMakeFiles/minicc.dir/src/codegen.cpp.o
#       CMakeFiles/minicc.dir/src/main.cpp.o
#       -o minicc                                ← 输出文件名
#       -L/opt/homebrew/opt/llvm/lib/c++         ← ★ link_directories() 的效果！
#
# 对应关系:
#   CMakeLists.txt                              link.txt
#   ───────────────────────────────             ─────────────────────
#   add_executable(minicc ${SOURCES})           → -o minicc + 所有 .o
#   link_directories(".../llvm/lib/c++")        → -L.../llvm/lib/c++ (末尾)
#
# ★ 如果注释掉 link_directories，末尾的 -L.../llvm/lib/c++ 就消失
#   链接器找不到 LLVM 21 的 libc++，就会用系统的旧版 libc++
#   → ABI 不匹配 → Undefined symbols → 链接失败
#
# =============================================================================
