src/semantic_analyzer.s: src/semantic_analyzer.cpp.s
.PHONY : src/semantic_analyzer.s
src/semantic_analyzer.cpp.s:
    $(MAKE) $(MAKESILENT) -f CMakeFiles/minicc.dir/build.make \
